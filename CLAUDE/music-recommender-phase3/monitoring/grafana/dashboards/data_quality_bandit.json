{
  "title": "Data Quality & Bandit Health",
  "uid": "data-quality-bandit",
  "tags": ["music-recommender", "quality", "bandit"],
  "timezone": "browser",
  "refresh": "60s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Catalog: Total Songs",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "music_catalog_songs_total", "legendFormat": "Songs" }]
    },
    {
      "id": 2,
      "title": "Catalog: Feature Completeness",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "music_catalog_songs_with_features / music_catalog_songs_total * 100",
        "legendFormat": "% Complete"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Bandit: Exploration Rate",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "music_bandit_exploration_rate * 100",
        "legendFormat": "% Exploring"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "description": "High exploration = bandit still learning. Should drop over time as users interact."
    },
    {
      "id": 4,
      "title": "Bandit: Mean Reward",
      "type": "gauge",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "music_bandit_mean_reward_per_user",
        "legendFormat": "Mean Reward"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Data Quality: Null Features (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(music_data_quality_null_features_total[1m]) * 60",
        "legendFormat": "{{feature}}"
      }],
      "description": "Spikes indicate bad data entering the pipeline. Should be near 0 after initial seed."
    },
    {
      "id": 6,
      "title": "Data Quality: Validation Failures",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(music_data_quality_validation_failures_total[5m]) * 300",
        "legendFormat": "{{check}}"
      }]
    },
    {
      "id": 7,
      "title": "Bandit: Arm Updates Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(music_bandit_arm_updates_total[1m]) * 60",
        "legendFormat": "Updates/min"
      }]
    },
    {
      "id": 8,
      "title": "Redis Cache Hit Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(music_redis_cache_hits_total[5m]) / (rate(music_redis_cache_hits_total[5m]) + rate(music_redis_cache_misses_total[5m]))",
          "legendFormat": "Hit Rate {{cache}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 9,
      "title": "Feedback Processing Latency",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(music_feedback_processing_latency_ms_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(music_feedback_processing_latency_ms_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 10,
      "title": "DB Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "music_db_pool_size",
        "legendFormat": "Pool Size"
      }]
    }
  ],
  "schemaVersion": 39
}
