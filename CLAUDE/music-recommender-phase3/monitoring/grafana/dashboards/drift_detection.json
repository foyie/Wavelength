{
  "title": "Drift Detection",
  "uid": "drift-detection",
  "tags": ["music-recommender", "drift", "monitoring"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "ADWIN Reward Signal — Current Mean",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "music_drift_adwin_current_mean{signal='reward'}",
        "legendFormat": "Reward Mean"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 0.3 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "ADWIN Window Size — Reward & CTR",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "music_drift_adwin_window_size{signal='reward'}",
          "legendFormat": "Reward Window"
        },
        {
          "expr": "music_drift_adwin_window_size{signal='ctr'}",
          "legendFormat": "CTR Window"
        }
      ],
      "description": "Sudden drops indicate drift was detected and window was shrunk"
    },
    {
      "id": 3,
      "title": "Drift Detections (cumulative)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "music_drift_adwin_detections_total",
          "legendFormat": "ADWIN {{signal}}"
        },
        {
          "expr": "music_drift_ks_detections_total",
          "legendFormat": "KS {{feature}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "CTR Trend (ADWIN)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "expr": "music_drift_adwin_current_mean{signal='ctr'}",
        "legendFormat": "CTR (adaptive mean)"
      }]
    },
    {
      "id": 5,
      "title": "KS Statistic per Audio Feature",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "expr": "music_drift_ks_statistic",
        "legendFormat": "{{feature}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "description": "KS statistic > 0.3 with p < 0.05 = significant drift"
    },
    {
      "id": 6,
      "title": "KS p-values (< 0.05 = drift)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "expr": "music_drift_ks_p_value",
        "legendFormat": "{{feature}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.05 },
              { "color": "green", "value": 0.1 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Feature Distribution Shift (reference vs current mean)",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "music_drift_ks_reference_mean",
          "legendFormat": "reference {{feature}}"
        },
        {
          "expr": "music_drift_ks_current_mean",
          "legendFormat": "current {{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1 }
      }
    }
  ],
  "schemaVersion": 39
}
