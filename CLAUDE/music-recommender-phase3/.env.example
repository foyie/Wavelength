# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Kafka (docker-compose sets these automatically)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_ENABLED=true

# Database / Redis (docker-compose sets defaults)
# DATABASE_URL=postgresql+asyncpg://music:music@localhost:5432/music_recommender
# REDIS_URL=redis://localhost:6379

# Bandit tuning (optional overrides)
# BANDIT_CONTEXT_WEIGHT=0.35
# BANDIT_CANDIDATE_POOL=500
# DEBUG=false
